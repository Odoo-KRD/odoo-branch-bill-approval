                '|', '|', '|', '|',
                ('approval_pending_user_id', '=', user.id),
                ('branch_approved_by', '=', user.id),
                ('rejected_by', '=', user.id),
                ('create_uid', '=', user.id),
                ('approval_submitted_by', '=', user.id)
            ]
        </field>
    </record>

    <record id="rule_account_move_ceo_approver" model="ir.rule">
